{
    "$schema": "https://opencode.ai/config.json",
    "model": "anthropic/claude-opus-5-5",
    "update": "disable",
    "share": "disabled",

    // Snapshots bloat the database: in 1.x their diffs produced 6.4 GiB of a 11.9 GiB
    // opencode.db. Costs undo/revert of file changes; git covers that. Revisit when
    // anomalyco/opencode#55010 is fixed.
    "snapshots": false,

    // The experimental todowrite tool; plugins/todo-state.js keeps its list in view. The
    // published schema does not know the key yet.
    "experimental": {
        "todo": true
    },

    "plugins": ["opencode-claude-auth@3.0.0"],

    "permissions": [
        // The last matching rule wins and the built-in default is allow (#54524),
        // so the catch-all ask comes first.
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "D:/Arbeit/**", "effect": "allow" },
        { "action": "external_directory", "resource": "E:/**", "effect": "allow" },
        // Paths inside the project match relative to it, everything else as an absolute
        // path, so this denies edits to sibling projects but never to the current one.
        { "action": "edit", "resource": "D:/Arbeit/**", "effect": "deny" },
        // Mail tools exist only in the mail agent, which allows its read-only ones again.
        { "action": "commonpost-mail_*", "resource": "*", "effect": "deny" }
    ],

    "agents": {
        "build": { "model": "anthropic/claude-opus-5-5#high" },
        "plan": { "model": "anthropic/claude-opus-5-5#high" },
        "explore": { "model": "anthropic/claude-opus-5-5#low" },
        "general": { "model": "anthropic/claude-opus-5-5#low" },

        // Reads Thunderbird mail, calendars and contacts on a local model and changes nothing;
        // plugins/local-only-mail.js refuses any other provider. All else is denied, the web
        // and subagents too, so a message's text cannot carry anything out. displayMessage
        // stays off: it marks the message read.
        "mail": {
            "description": "Reads Thunderbird mail on a local model, read-only",
            "mode": "primary",
            "model": "strata@Laptop-Finn/qwen3.8-flash-next-unsloth-ud-iq4_xs",
            "permissions": [
                { "action": "*", "resource": "*", "effect": "deny" },
                { "action": "read", "resource": "*", "effect": "allow" },
                { "action": "read", "resource": "*.env", "effect": "deny" },
                { "action": "read", "resource": "*.env.*", "effect": "deny" },
                { "action": "glob", "resource": "*", "effect": "allow" },
                { "action": "grep", "resource": "*", "effect": "allow" },
                { "action": "question", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listAccounts", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_getAccountAccess", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listFolders", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_searchMessages", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_getRecentMessages", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_getMessage", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_getMessages", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listFilters", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_searchContacts", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_getContact", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listCalendars", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listEvents", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listTasks", "resource": "*", "effect": "allow" },
                { "action": "commonpost-mail_listCategories", "resource": "*", "effect": "allow" }
            ]
        }
    },

    "mcp": {
        "servers": {

            "windows-mcp": {
                "type": "remote",
                "url": "http://10.0.0.53:8000/mcp",
                // The VM is usually off, and an unreachable server holds the first prompt back
                // for two 21 s connect attempts. Connect it in /mcps once the VM runs.
                "disabled": true,
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {file:~/.secrets/windows-mcp-key}"
                }
            },

            "atlassian": {
                "type": "remote",
                "url": "https://mcp.atlassian.com/v1/mcp",
                "oauth": {}
            },

            "chrome-devtools": {
                "type": "local",
                "command": [
                    "C:\\Program Files\\nodejs\\npx.cmd", // forward slashes fail to launch (#52771)
                    "-y",
                    "chrome-devtools-mcp@latest",
                    "--executablePath=C:/Users/{env:USERNAME}/AppData/Local/Chromium/Application/chrome.exe",
                    "--userDataDir=C:/Users/{env:USERNAME}/.cache/chrome-devtools-mcp/opencode-profile-{env:CHROME_SLOT}",
                    "--no-usage-statistics",
                    "--ignoreDefaultChromeArg=--enable-automation",
                    "--chromeArg=--disable-blink-features=AutomationControlled"
                ],
                // The npx shim resolves `node` from Path again, so an active conda env would
                // otherwise pick the MCP's Node. No timeout: the 30 s startup default covers
                // npx's registry check.
                "environment": {
                    "Path": "C:\\Program Files\\nodejs;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem"
                }
            },

            // Chrome on an Android device over adb forward tcp:9222 localabstract:chrome_devtools_remote;
            // connects on first use, so it idles harmlessly while no device is forwarded.
            "chrome-android": {
                "type": "local",
                "command": [
                    "C:\\Program Files\\nodejs\\npx.cmd", // forward slashes fail to launch (#52771)
                    "-y",
                    "chrome-devtools-mcp@latest",
                    "--browser-url=http://127.0.0.1:9222",
                    "--no-usage-statistics"
                ],
                "environment": {
                    "Path": "C:\\Program Files\\nodejs;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem"
                }
            },

            "blender": {
                // Blender's own MCP (projects.blender.org/lab/blender_mcp), not the third-party
                // mcp-for-blender: it inspects .blend files (missing files, linked libraries),
                // searches the API docs and manual offline, sends no telemetry and has no paid
                // tier. mcp-for-blender only adds asset imports and AI-generated models.
                // Starts without Blender; tools reach it once Blender runs the "MCP" extension,
                // which starts its server itself.
                "type": "local",
                // blmcp from main in the conda env "blender-mcp", installed from D:\Arbeit\blender_mcp\mcp.
                // It reports 1.0.2 but includes the 1.0.3 fix (#31) and the Blender 5.2 docs: the
                // v1.0.3 tag sits on a side branch that main never merged.
                // To upgrade, git pull there, pip install it into the env again, and update the
                // extension in Blender (Preferences, Get Extensions) to the same version.
                "command": ["C:\\Miniconda\\envs\\blender-mcp\\python.exe", "-m", "blmcp"]
            },

            // Thunderbird mail through the Commonpost MCP add-on 0.17.3 (bridge 0.17.1), for the
            // mail agent only: connect it in /mcps when needed. plugins/local-only-mail.js keeps
            // its data on local models, which needs the tools outside Code Mode. The bridge never
            // updates itself: replace mcp-bridge.cjs when the add-on's options page (Bridge) says
            // so. If it cannot reach Thunderbird after a Thunderbird update, check whether
            // Experiment add-ons were suppressed (extensions.experiments.suppressed).
            "commonpost-mail": {
                "type": "local",
                "command": [
                    "C:\\Program Files\\nodejs\\node.exe", // forward slashes fail to launch (#52771)
                    "C:/Users/{env:USERNAME}/commonpost-mcp/mcp-bridge.cjs"
                ],
                "disabled": true,
                "codemode": false
            }
        }
    },

    // The models of a llama.cpp provider come from its server's presets, those of a Strata
    // provider from its loaded model (plugins/llama-limits.js).
    "provider": {

        "llama.cpp@PC-Finn": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server@PC-Finn",
            "options": {
                "baseURL": "http://pc-finn:8080/v1"
            }
        },

        "llama.cpp@Laptop-Finn": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server@Laptop-Finn",
            "options": {
                "baseURL": "http://laptop-finn:8080/v1"
            }
        },

        "strata@Laptop-Finn": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "strata@Laptop-Finn",
            "options": {
                "baseURL": "http://laptop-finn:8083/v1"
            }
        }
    }
}
